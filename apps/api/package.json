{
  "name": "@sospatas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "dev": "wrangler dev",
    "dev:node": "tsx watch src/node.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "tipos": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "typecheck": "wrangler types --strict-vars=false --env-file .dev.vars.example && tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@sospatas/compartilhado": "workspace:*",
    "@sospatas/db": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
