# Copie para .env.local se precisar. Em desenvolvimento, deixe vazio: o Vite manda /api
# para o `wrangler dev`. Na prévia (etapa 8), aponta para o Worker *.workers.dev.
VITE_API_URL=

# Chave pública do Turnstile (Cloudflare). Vazia no computador: usa a chave de teste, que sempre
# aprova. Prévia e produção: a chave do site criada no painel do Turnstile.
VITE_TURNSTILE_SITE_KEY=
